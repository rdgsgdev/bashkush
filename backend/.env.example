# ─────────────────────────────────────────────────────────────
# Bashkush Backend — variables d'environnement
# ─────────────────────────────────────────────────────────────
# Copiez ce fichier en `.env` puis renseignez les valeurs
# depuis votre projet Supabase (Settings → API / Database).

# Port d'écoute du serveur Express (Render injecte automatiquement PORT)
PORT=4000

# Environnement : development | production
NODE_ENV=development

# URL du frontend autorisé en CORS (origines séparées par une virgule)
# En local : http://localhost:5173 (Vite). En prod : l'URL Render du frontend.
FRONTEND_URL=http://localhost:5173

# ── Supabase (Project Settings → API) ───────────────────────
SUPABASE_URL=https://VOTRE_PROJET.supabase.co
# Clé SERVICE ROLE (secret côté serveur — ne JAMAIS exposer côté frontend)
SUPABASE_SERVICE_ROLE_KEY=votre-service-role-key

# ── Base de données Postgres (Supabase → Connect → ORM/Session pooler) ──
# ⚠️ IMPORTANT : utilisez le POOLEUR DE SESSION (port 5432), PAS le pooleur
# de transaction (6563). L'application s'appuie sur des transactions Prisma
# interactives (planification → liste de courses) qui NE fonctionnent PAS sur
# le pooleur de transaction (erreur P2028 « Transaction not found »).
# De plus, n'ajoutez PAS le suffixe ?pgbouncer=true (réservé au mode transaction).
#
# Format : postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres

# Connexion pour `prisma db push` / migrations : le pooleur de session convient.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres

# Bucket Storage Supabase (doit être créé et PUBLIC en lecture)
SUPABASE_BUCKET=meals-images

# ── Génération de plats par IA (Perplexity → https://www.perplexity.ai/settings/api) ──
# Clé absente : la fonctionnalité IA répondra 503 (le reste de l'app fonctionne).
PERPLEXITY_API_KEY=
# Modèle à utiliser (défaut : sonar — bon rapport qualité/prix pour du JSON structuré).
PERPLEXITY_MODEL=sonar
