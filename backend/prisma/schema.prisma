// ─────────────────────────────────────────────────────────────
// Bashkush — Schéma Prisma (PostgreSQL / Supabase)
// ─────────────────────────────────────────────────────────────
// Source de vérité du modèle de données.
// Appliquer les changements :  npx prisma db push
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // connexion poolée (exécution)
  directUrl = env("DIRECT_URL")     // connexion directe (db push / migrations)
}

// ── Profil utilisateur ───────────────────────────────────────
// 1 profil par utilisateur Supabase Auth (userId = auth.users.id).
// onboardedAt null → onboarding à faire à la prochaine connexion.

model Profile {
  userId      String    @id @map("user_id")
  fullName    String?   @map("full_name")
  birthDate   DateTime? @map("birth_date")
  sex         String? // homme | femme (anciennes valeurs possible en base : autre | non_precise)
  heightCm    Float?    @map("height_cm")
  weightKg    Float?    @map("weight_kg")
  activityLevel String? @map("activity_level") // sedentaire | legerement_actif | moderement_actif | tres_actif | extremement_actif
  weeklyActivity String? @map("weekly_activity") // moins_1h | 1_3h | 3_5h | 5_7h | plus_7h
  fitnessLevel String? @map("fitness_level") // debutant | intermediaire | avance
  goals       String[] // perdre_poids | maintenir_poids | prendre_poids | masse_musculaire | condition_physique | autre
  goalOther   String?   @map("goal_other")
  medicalConditions String[] @map("medical_conditions") // diabete | hypertension | cholesterol | allergies | autre
  allergies   String?
  medications String?
  medicalOther String? @map("medical_other")
  mealFrequency String? @map("meal_frequency") // 3_repas | 4_6_repas | jeune_intermittent | autre
  mealFrequencyOther String? @map("meal_frequency_other")
  foodChoices String[] @map("food_choices") // fruits | legumes | cereales_completes | proteines_maigres | produits_laitiers | noix_graines | legumineuses | autre
  foodOther   String?  @map("food_other")
  notes       String?
  photoUrl    String?  @map("photo_url")
  imagePath   String?  @map("image_path")
  // Objectifs quotidiens — calculés (Mifflin-St Jeor + objectif) ou saisis
  // manuellement (targetsManual). null si données insuffisantes.
  dailyCalories Int?   @map("daily_calories") // kcal/jour
  dailyProtein  Int?   @map("daily_protein")  // g de protéines/jour
  targetsManual Boolean @default(false) @map("targets_manual") // true = saisis à la main (sync → recalcul)
  onboardedAt DateTime? @map("onboarded_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Famille de l'utilisateur (null → famille créée paresseusement à la
  // première utilisation). Les plats, planifications et listes de courses
  // sont scopés à cette famille.
  familyId String? @map("family_id")
  family   Family? @relation(fields: [familyId], references: [id])

  familyInvitesSent  FamilyMember[] @relation("FamilyInviter")
  familyMemberships  FamilyMember[] @relation("FamilyMember")

  @@map("profiles")
}

// ── Famille ──────────────────────────────────────────────────
// Un groupe de famille : les plats, planifications et listes de
// courses appartiennent à une famille et ne sont visibles que de
// ses membres. Un utilisateur appartient à 0 ou 1 famille.

model Family {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  profiles     Profile[]
  members      FamilyMember[]
  meals        Meal[]
  mealPlans    MealPlan[]
  groceryItems GroceryItem[]

  @@map("families")
}

// Invitation au sein d'une famille : invitedById invite memberEmail.
// Le lien devient "accepted" dès que la personne dispose d'un compte
// (userId connu). La famille d'un membre = profiles.family_id.

model FamilyMember {
  id           String   @id @default(uuid())
  familyId     String   @map("family_id")
  invitedById  String   @map("invited_by_id") // celui qui invite (affichage de la direction)
  memberEmail  String   @map("member_email") // courriel invité (minuscules)
  memberUserId String?  @map("member_user_id") // rempli quand la personne a un compte
  status       String   @default("pending") // pending | accepted
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  family  Family  @relation(fields: [familyId], references: [id], onDelete: Cascade)
  inviter Profile @relation("FamilyInviter", fields: [invitedById], references: [userId], onDelete: Cascade)
  member  Profile? @relation("FamilyMember", fields: [memberUserId], references: [userId], onDelete: SetNull)

  @@unique([familyId, memberEmail])
  @@index([memberEmail])
  @@map("family_members")
}

// ── Plats ────────────────────────────────────────────────────

model Meal {
  id          String   @id // slug issu du JSON ou UUID pour création manuelle
  familyId    String   @map("family_id") // visibilité : plats de la famille uniquement
  name        String
  description String?
  servings    Int      @default(2) // portions de référence des quantités d'ingrédients
  prepTime    Int?     @map("prep_time")
  cookTime    Int?     @map("cook_time")
  totalTime   Int?     @map("total_time")
  difficulty  String? // facile | moyen | difficile
  category    String? // midi | soir | collation | autre
  nutrition   Json? // { calories, protein, carbs, fat, fiber }
  notes       String?
  isFavorite  Boolean  @default(false) @map("is_favorite")
  imageUrl    String?  @map("image_url")
  imagePath   String?  @map("image_path") // chemin dans le bucket Storage
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  family      Family        @relation(fields: [familyId], references: [id])
  ingredients Ingredient[]
  steps       Step[]
  mealPlans   MealPlan[]

  @@index([familyId])
  @@map("meals")
}

model Ingredient {
  id       String // id de l'ingrédient (portée par repas)
  mealId   String @map("meal_id")
  name     String
  quantity Float
  unit     String
  aisle    String // clé de rayon (ex: fruits_legumes) ou rayon personnalisé
  optional Boolean @default(false)
  notes    String?
  nutrition Json? // { calories, protein, carbs, fat, fiber, quantity } — apports pour `quantity` unités

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@id([mealId, id])
  @@index([aisle])
  @@map("ingredients")
}

model Step {
  mealId      String   @map("meal_id")
  stepNumber  Int      @map("step_number")
  instruction String
  time        Int?
  ingredients Json? // tableau d'ids d'ingrédients utilisés

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@id([mealId, stepNumber])
  @@map("steps")
}

// ── Planification ────────────────────────────────────────────

model MealPlan {
  id       String   @id @default(uuid())
  familyId String   @map("family_id") // visibilité : planifications de la famille uniquement
  mealId   String   @map("meal_id")
  fromDate DateTime @map("from_date")
  toDate   DateTime @map("to_date")
  servings Int      @default(2) // 1..10
  status   String   @default("a_faire") // a_faire | en_preparation | prepare
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meal          Meal                 @relation(fields: [mealId], references: [id], onDelete: Cascade)
  family        Family               @relation(fields: [familyId], references: [id])
  contributions GroceryContribution[]

  @@index([familyId, fromDate, toDate])
  @@map("meal_plans")
}

// ── Liste de courses ─────────────────────────────────────────

model GroceryItem {
  id        String   @id @default(uuid())
  familyId  String   @map("family_id") // visibilité : liste propre à chaque famille
  name      String
  quantity  Float // quantité totale affichée (authoritaire)
  unit      String
  aisle     String
  isManual  Boolean  @default(false) @map("is_manual") // créé à la main → jamais auto-supprimé
  checked   Boolean  @default(false) // acheté / déjà possédé
  archived  Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  family        Family               @relation(fields: [familyId], references: [id])
  contributions GroceryContribution[]

  @@index([familyId, aisle])
  @@index([familyId, archived])
  @@map("grocery_items")
}

// Lien entre un item de liste et le plan qui l'a généré.
// Permet de recalculer les quantités quand un plan change/supprimé.
model GroceryContribution {
  id            String @id @default(uuid())
  groceryItemId String @map("grocery_item_id")
  mealPlanId    String @map("meal_plan_id")
  ingredientId  String @map("ingredient_id")
  quantity      Float // quantité apportée par ce plan (déjà mise à l'échelle)

  groceryItem GroceryItem @relation(fields: [groceryItemId], references: [id], onDelete: Cascade)
  mealPlan    MealPlan    @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  @@unique([mealPlanId, ingredientId])
  @@index([groceryItemId])
  @@map("grocery_contributions")
}

// Ordre d'affichage des rayons (+ rayons personnalisés).
model GroceryAisle {
  name      String  @id // clé (ex: fruits_legumes)
  label     String? // libellé affiché (ex: "Fruits & légumes")
  sortOrder Int     @default(0) @map("sort_order")
  isDefault Boolean @default(false) @map("is_default")

  @@map("grocery_aisles")
}
